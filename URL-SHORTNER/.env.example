# Local development only. On Render use DATABASE_URL for PostgreSQL.
DATABASE_URL=sqlite:///./url_shortener.db
# Leave BASE_URL unset on Render: RENDER_EXTERNAL_URL is used automatically.
# Set BASE_URL only to override with your custom domain.
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
CREATE_LIMIT_PER_MINUTE=30
